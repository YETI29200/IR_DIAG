# Environment Variables Example
# Copy this file to .env and fill in your values

# Microsoft Exchange SMTP Configuration (optional - for real email sending)
# If not set, emails will be simulated and logged only
EXCHANGE_HOST=smtp.office365.com
EXCHANGE_PORT=587
EXCHANGE_USER=your-email@yourdomain.com
EXCHANGE_PASSWORD=your-password-or-app-password
EXCHANGE_FROM_EMAIL=your-email@yourdomain.com
EXCHANGE_SECURE=false
# Set EXCHANGE_SECURE=true for SSL (port 465), false for STARTTLS (port 587)

# Session Secret for token signing
SESSION_SECRET=your-secret-key-change-in-production-min-32-chars

# Server Configuration
PORT=3000

# Database Path (relative to project root)
DB_PATH=./data/diagnostic.db

# Anthropic Claude API Configuration (optional - for AI-powered recommendations)
# If not set, static recommendations will be used
# Get your API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Available models: claude-haiku-4-5-20251001 (rapide/économique), claude-sonnet-4-6 (qualité supérieure)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Base URL for questionnaire links (optional)
# In development, leave empty to use relative URLs
# In production: BASE_URL=https://diagnostic.images-reseaux.fr
# BASE_URL=http://localhost:5173
