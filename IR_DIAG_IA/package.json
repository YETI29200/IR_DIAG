{
  "name": "ai-data-maturity-diagnostic",
  "version": "1.0.0",
  "description": "AI & Data Maturity Diagnostic Platform - Images & Réseaux",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "cd client && vite",
    "start": "node server/index.js",
    "server": "node server/index.js",
    "build": "cd client && vite build",
    "preview": "cd client && vite preview",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "db:demo": "node server/db/demo-seed.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/nodemailer": "^7.0.11",
    "better-sqlite3": "^11.1.0",
    "chart.js": "^4.5.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "nodemailer": "^8.0.1",
    "puppeteer": "^24.36.0",
    "tailwindcss": "^4.1.18",
    "vue": "^3.4.21",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^8.2.2",
    "sass": "^1.77.0",
    "typescript": "^5.4.2",
    "vite": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
